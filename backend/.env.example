# Port the Express server will listen on
PORT=5000

# MongoDB connection string
MONGODB_URI=mongodb://127.0.0.1:27017/ecommerce

# Secret used to sign JWTs -- change this to a long random string in any
# real deployment. Do NOT commit your actual .env file to version control.
JWT_SECRET=replace_this_with_a_long_random_secret_string

# Optional: absolute or relative path to the frontend folder to serve as
# static files. Defaults to ../frontend relative to backend/server.js.
# FRONTEND_PATH=../frontend
